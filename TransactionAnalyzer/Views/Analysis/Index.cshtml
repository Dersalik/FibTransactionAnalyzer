@{
    ViewData["Title"] = "Analyze Statement";
}

<section class="page-head">
    <div class="container">
        <h1 class="page-title">Analyze Statement</h1>
        <p class="page-sub">Upload your CSV export and choose what to include.</p>
    </div>
</section>

<div class="container page-body">
    <div class="row analyze-layout">
        <form asp-controller="Analysis" asp-action="UploadAndAnalyze" method="post" enctype="multipart/form-data" class="analyze-form" id="analyzeForm" novalidate>
            @Html.AntiForgeryToken()

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="alert" role="alert">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            }

            <div class="card stack">
                <div>
                    <label for="file" class="card-title">Statement file</label>
                    <p class="card-sub">The CSV you exported from your banking app (.csv or .txt, up to 2 MB).</p>
                </div>
                <div class="dropzone" id="dropzone">
                    <input type="file" id="file" name="file" accept=".csv,.txt" required aria-describedby="fileStatus" />
                    <span class="icon-chip in drop-icon">
                        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 16V4m0 0L7 9m5-5l5 5M4 15v3a2 2 0 002 2h12a2 2 0 002-2v-3" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    </span>
                    <strong>Drag your file here</strong>
                    <span class="muted">or</span>
                    <span class="btn btn-mint">Choose file</span>
                    <span class="drop-status" id="fileStatus" aria-live="polite">No file selected</span>
                </div>
            </div>

            <div class="card option-row">
                <span class="icon-chip">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4 7h13l-3-3 1.4-1.4L21 8l-5.6 5.4L14 12l3-3H4V7zm16 10H7l3 3-1.4 1.4L3 16l5.6-5.4L10 12l-3 3h13v2z" /></svg>
                </span>
                <div class="grow">
                    <label for="ignoreInternalTransactions" class="option-title">Exclude internal transfers</label>
                    <p class="card-sub">Auto-saving and Money Box moves between your own accounts won’t count as income or spending.</p>
                </div>
                <input type="checkbox" role="switch" class="switch" id="ignoreInternalTransactions" name="ignoreInternalTransactions" value="true" checked />
            </div>

            <fieldset class="card stack period">
                <legend class="visually-hidden">Period</legend>
                <div>
                    <span class="option-title">Period</span>
                    <p class="card-sub">Leave on “All time” to include every transaction in the file.</p>
                </div>
                <div class="chips" role="group" aria-label="Period presets">
                    <button type="button" class="chip-btn" data-period="30d" aria-pressed="false">Last 30 days</button>
                    <button type="button" class="chip-btn" data-period="year" aria-pressed="false">This year</button>
                    <button type="button" class="chip-btn" data-period="all" aria-pressed="true">All time</button>
                    <button type="button" class="chip-btn" data-period="custom" aria-pressed="false">Custom</button>
                </div>
                <div class="date-grid" id="customDates" hidden>
                    <div class="field">
                        <label for="dateFrom">From</label>
                        <input type="date" class="input" id="dateFrom" name="dateFrom" />
                    </div>
                    <div class="field">
                        <label for="dateTo">To</label>
                        <input type="date" class="input" id="dateTo" name="dateTo" />
                    </div>
                    <p class="card-sub date-hint" id="dateHint">“From” must be on or before “To”.</p>
                </div>
            </fieldset>

            <button type="submit" class="btn btn-primary btn-block" id="analyzeBtn">Analyze transactions</button>
        </form>

        <aside class="analyze-aside">
            <div class="card stack">
                <h2 class="card-title">How it works</h2>
                <ol class="steps">
                    <li><span class="icon-chip ink sm">1</span><div><strong>Export from your bank app</strong><span class="muted">Save your transaction history as a CSV file.</span></div></li>
                    <li><span class="icon-chip ink sm">2</span><div><strong>Upload and choose options</strong><span class="muted">Pick a period and whether to skip internal transfers.</span></div></li>
                    <li><span class="icon-chip ink sm">3</span><div><strong>Read your report</strong><span class="muted">One report per currency: balance, cash flow, types, counterparties and income.</span></div></li>
                </ol>
            </div>
            <div class="card privacy-note">
                <svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                <span>Your file is processed in memory only and discarded once the report is ready.</span>
            </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="~/js/analyze.js" asp-append-version="true"></script>
}
