@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<section class="page-head">
    <div class="container">
        <h1 class="page-title">Something went wrong</h1>
        <p class="page-sub">An error occurred while processing your request. Nothing from your file was stored.</p>
    </div>
</section>

<div class="container page-body">
    <div class="card">
        @if (Model.ShowRequestId)
        {
            <p class="muted">Request ID: <code>@Model.RequestId</code></p>
        }
        <p style="margin-top: 16px">
            <a class="btn btn-primary" asp-controller="Analysis" asp-action="Index">Try another file</a>
        </p>
    </div>
</div>
