@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string? Current(string c, string a) => controller == c && action == a ? "page" : null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Transaction Analyzer</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <header class="site-header">
        <div class="container">
            <a class="brand" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">
                    <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 13l4-4 3 2.5L16 6" stroke="#FFFFFF" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
                Transaction Analyzer
            </a>
            <nav class="pill-nav" aria-label="Main">
                <a asp-controller="Home" asp-action="Index" aria-current="@Current("Home", "Index")">Home</a>
                <a asp-controller="Analysis" asp-action="Index" aria-current="@(controller == "Analysis" ? "page" : null)">Analyze</a>
                <a asp-controller="Home" asp-action="Privacy" aria-current="@Current("Home", "Privacy")">Privacy</a>
            </nav>
            <a class="btn btn-mint" asp-controller="Analysis" asp-action="Index">+ Analyze a file</a>
        </div>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="site-footer">
        <div class="container">
            <span>&copy; @DateTime.UtcNow.Year Transaction Analyzer · Independent tool, not affiliated with First Iraqi Bank</span>
            <a asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
