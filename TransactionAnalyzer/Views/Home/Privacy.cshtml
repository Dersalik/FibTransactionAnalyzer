@{
    ViewData["Title"] = "Privacy Policy";
}

<section class="page-head">
    <div class="container">
        <h1 class="page-title">Privacy Policy</h1>
        <p class="page-sub">Your privacy is our priority. Here is exactly how your transaction data is handled.</p>
    </div>
</section>

<div class="container page-body">
    <div class="grid" style="--min: 300px">
        <div class="card pillar">
            <span class="icon-chip in"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2l8 3.5v5.5c0 5-3.4 9.4-8 11-4.6-1.6-8-6-8-11V5.5L12 2zm-1.2 13.2l5.9-5.9-1.4-1.4-4.5 4.5-2.1-2.1-1.4 1.4 3.5 3.5z" /></svg></span>
            <h2>No data storage</h2>
            <p class="muted">We do not store, save or retain any of your transaction data on our servers.</p>
        </div>
        <div class="card pillar">
            <span class="icon-chip in"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 110 20 10 10 0 010-20zm1 5h-2v6l5 3 1-1.7-4-2.4V7z" /></svg></span>
            <h2>Temporary processing</h2>
            <p class="muted">Analysis happens in server memory only while your report is built, then everything is cleared.</p>
        </div>
        <div class="card pillar">
            <span class="icon-chip in"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 5c5 0 9 4.5 10 7-1 2.5-5 7-10 7S3 14.5 2 12c1-2.5 5-7 10-7zm0 3a4 4 0 100 8 4 4 0 000-8zm-8.7-5.3l18 18-1.4 1.4-18-18 1.4-1.4z" /></svg></span>
            <h2>No tracking</h2>
            <p class="muted">No cookies, analytics or tracking of any kind. All traffic is encrypted with HTTPS.</p>
        </div>
    </div>

    <div class="row">
        <div class="card grow-1 stack">
            <h2 class="card-title">When you upload a file</h2>
            <ol class="steps">
                <li><span class="icon-chip ink sm">1</span>Your file is processed as soon as it is uploaded</li>
                <li><span class="icon-chip ink sm">2</span>Data is analysed in real time for insights</li>
                <li><span class="icon-chip ink sm">3</span>Results are shown to you straight away</li>
                <li><span class="icon-chip ink sm">4</span>All data is discarded after processing</li>
            </ol>
            <p class="callout">Your data may exist in server memory during analysis. It is never written to disk, databases or log files, and is removed from memory as soon as results are returned.</p>
        </div>
        <div class="card grow-1">
            <h2 class="card-title" style="margin-bottom: 8px">What we never do</h2>
            @foreach (var (title, text) in new[] {
                ("No data sharing", "Never shared with third parties"),
                ("No data sales", "Never sold or monetised"),
                ("No profiling", "No profiles of your spending habits"),
                ("No retention", "No copies or backups are kept") })
            {
                <div class="list-row">
                    <span class="icon-chip out sm"><svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 4l8 8M12 4l-8 8" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /></svg></span>
                    <div class="grow"><span class="title" style="font-weight: 600">@title</span><span class="sub">@text</span></div>
                </div>
            }
        </div>
    </div>

    <div class="card cta">
        <div class="cta-copy">
            <span class="icon-chip"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M8 7l-5 5 5 5M16 7l5 5-5 5M14 4l-4 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg></span>
            <div>
                <h2 class="card-title">Open source</h2>
                <p class="muted">Every line of code, including how your data is processed, is public. You can verify these claims yourself.</p>
            </div>
        </div>
        <a class="btn btn-outline btn-lg" href="https://github.com/Dersalik/FibTransactionAnalyzer" target="_blank" rel="noopener">View source code<span class="visually-hidden"> (opens in new tab)</span></a>
    </div>

    <p class="card note-card">Questions about this policy or how your data is handled? Open an issue on the GitHub repository. This page is updated whenever data handling changes.</p>
</div>

