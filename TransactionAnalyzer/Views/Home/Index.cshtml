@{
    ViewData["Title"] = "Transaction Analyzer";
}

<section class="hero">
    <div class="container hero-inner">
        <div class="hero-copy">
            <span class="hero-tag">For FIB statement exports · CSV</span>
            <h1>Understand your money in one clear report.</h1>
            <p>Upload the transaction file you exported from your banking app. See your balance over time, monthly cash flow, transaction types and the people you pay most, for each currency.</p>
            <div class="hero-actions">
                <a class="btn btn-primary btn-lg" asp-controller="Analysis" asp-action="Index">Start analysis</a>
                <a class="btn btn-outline btn-lg" asp-controller="Home" asp-action="Privacy">How your data is handled</a>
            </div>
        </div>

        <div class="hero-preview" aria-label="Example report with sample figures">
            <div class="card card-raised preview-net">
                <svg width="56" height="56" viewBox="0 0 64 64" aria-hidden="true">
                    <circle cx="32" cy="32" r="27" fill="none" stroke="#EEF0F4" stroke-width="6" />
                    <circle cx="32" cy="32" r="27" fill="none" stroke="#3FB39A" stroke-width="6" stroke-linecap="round" stroke-dasharray="146 170" transform="rotate(-90 32 32)" />
                </svg>
                <div>
                    <span class="muted">Net change</span>
                    <strong class="num">+7,460,000 <small>IQD</small></strong>
                </div>
            </div>
            <div class="preview-pair">
                <div class="card"><span class="muted">Money in</span><strong class="amount-in num">+53.37M</strong></div>
                <div class="card"><span class="muted">Money out</span><strong class="amount-out num">−45.91M</strong></div>
            </div>
            <div class="card preview-bars" aria-hidden="true">
                @foreach (var (inH, outH) in new[] { (60, 49), (46, 36), (54, 71), (68, 52), (73, 60), (81, 62), (96, 69), (64, 82), (86, 58) })
                {
                    <div><span class="bar-in" style="height:@(inH)%"></span><span class="bar-out" style="height:@(outH)%"></span></div>
                }
            </div>
            <span class="muted preview-caption">Example report with sample figures</span>
        </div>
    </div>
</section>

<div class="container page-body">
    <h2 class="section-title">What you get</h2>
    <div class="grid">
        <div class="card feature">
            <span class="icon-chip"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3 20V4h2v14h16v2H3zm4-4l4-5 3 3 5-7 1.6 1.2L14.3 17 11 13.8 8.6 17H7z" /></svg></span>
            <h3>Balance &amp; cash flow</h3>
            <p class="muted">Your balance after every transaction, and money in vs. out for each month.</p>
        </div>
        <div class="card feature">
            <span class="icon-chip"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 3C7 3 3 4.8 3 7v10c0 2.2 4 4 9 4s9-1.8 9-4V7c0-2.2-4-4-9-4zm0 2c4 0 7 1.3 7 2s-3 2-7 2-7-1.3-7-2 3-2 7-2zm-7 5c1.8 1 4.3 1.5 7 1.5s5.2-.5 7-1.5v2c0 .7-3 2-7 2s-7-1.3-7-2v-2z" /></svg></span>
            <h3>Each currency on its own</h3>
            <p class="muted">IQD, USD and EUR are kept apart, with a switch at the top of the report.</p>
        </div>
        <div class="card feature">
            <span class="icon-chip"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M9 11a4 4 0 100-8 4 4 0 000 8zm7 0a3 3 0 100-6 3 3 0 000 6zM2 20c0-3.3 3.1-6 7-6s7 2.7 7 6H2zm15.5 0c0-2-.8-3.8-2.1-5.1.5-.1 1-.1 1.6-.1 3 0 5 2.2 5 5.2h-4.5z" /></svg></span>
            <h3>Counterparties</h3>
            <p class="muted">Who you sent money to and received it from, with the net balance for each.</p>
        </div>
        <div class="card feature">
            <span class="icon-chip"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M11 2v10h10A10 10 0 0011 2zM9 4.1A10 10 0 1019.9 15H9V4.1z" /></svg></span>
            <h3>Types &amp; income</h3>
            <p class="muted">Spending by transaction type, the largest payment in each, and your monthly income range.</p>
        </div>
    </div>

    <div class="card cta">
        <div class="cta-copy">
            <span class="icon-chip in">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l7 3v5c0 4.5-3 8.2-7 10-4-1.8-7-5.5-7-10V6l7-3z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            </span>
            <div>
                <h3>Nothing is stored</h3>
                <p class="muted">Your file is read in memory, the report is built, and the data is discarded. No accounts, cookies or tracking.</p>
            </div>
        </div>
        <a class="btn btn-primary btn-lg" asp-controller="Analysis" asp-action="Index">Analyze now</a>
    </div>
</div>

